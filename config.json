    "process_exclusions": [
        "system",
        "csrss.exe",
        "wininit.exe",
        "services.exe",
        "lsass.exe",
        "explorer.exe",
        "svchost.exe",
        "smss.exe",
        "python.exe",
        "pythonw.exe",
        "cmd.exe",
        "powershell.exe",
