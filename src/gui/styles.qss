/* ============================================================
   Faster PC — الأنماط البصرية الموحّدة
   الهوية: خلفية داكنة + أخضر أساسي، مع ألوان حالة واضحة.
   ============================================================ */

* {
    font-family: "Segoe UI", "Tahoma", "Arial", sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog, QWizard, QWizardPage {
    background-color: #16171d;
}

QLabel {
    color: #e6e6e6;
    background: transparent;
}

QLabel#cardTitle {
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
}

QLabel#sectionHeader {
    color: #9a9dab;
    font-size: 12px;
    font-weight: 700;
    padding-top: 6px;
}

QLabel#statTitle {
    color: #9a9dab;
    font-size: 12px;
}

QLabel#statSubtitle {
    color: #9a9dab;
    font-size: 11px;
}

QLabel#statValue {
    color: #ffffff;
}

QFrame#card {
    background-color: #1e1f26;
    border: 1px solid #2e303c;
    border-radius: 10px;
}

QFrame#headerBar {
    background-color: #1e1f26;
    border: 1px solid #2e303c;
    border-radius: 10px;
}

QFrame#toast {
    background-color: #24262f;
    border: 1px solid #2e303c;
    border-radius: 8px;
}

/* --------------------------- أزرار --------------------------- */
QPushButton {
    background-color: #333648;
    color: #ffffff;
    border: 1px solid #3a3d4d;
    border-radius: 6px;
    padding: 8px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #40465c;
}

QPushButton:pressed {
    background-color: #2a2c38;
}

QPushButton:disabled {
    background-color: #2a2c38;
    color: #6a6d7a;
    border-color: #2e303c;
}

QPushButton#primaryButton {
    background-color: #27ae60;
    border: none;
}

QPushButton#primaryButton:hover {
    background-color: #2ecc71;
}

QPushButton#dangerButton {
    background-color: #c0392b;
    border: none;
}

QPushButton#dangerButton:hover {
    background-color: #e74c3c;
}

/* --------------------------- إدخال --------------------------- */
QLineEdit, QSpinBox, QComboBox {
    background-color: #2a2c38;
    color: #ffffff;
    border: 1px solid #3a3d4d;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: #4a90e2;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid #4a90e2;
}

QComboBox QAbstractItemView {
    background-color: #2a2c38;
    color: #ffffff;
    selection-background-color: #4a90e2;
}

QCheckBox {
    color: #cfd0d8;
    padding: 3px 0;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #4a4d5e;
    background: #24262f;
}

QCheckBox::indicator:checked {
    background: #27ae60;
    border-color: #27ae60;
}

/* --------------------------- عرض البيانات --------------------------- */
QTextEdit, QPlainTextEdit {
    background-color: #16171d;
    color: #d6d6d6;
    border: 1px solid #2e303c;
    border-radius: 6px;
    font-family: "Consolas", "Menlo", monospace;
    font-size: 12px;
}

QTableWidget, QListWidget {
    background-color: #1a1b22;
    alternate-background-color: #1e1f26;
    color: #e6e6e6;
    border: 1px solid #2e303c;
    border-radius: 8px;
    gridline-color: #262833;
    selection-background-color: #2c3a52;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #24262f;
    color: #b9bccb;
    border: none;
    border-right: 1px solid #2e303c;
    border-bottom: 1px solid #2e303c;
    padding: 7px 8px;
    font-weight: 700;
}

QTabWidget::pane {
    border: 1px solid #2e303c;
    border-radius: 8px;
    top: -1px;
    background-color: #1a1b22;
}

QTabBar::tab {
    background-color: #24262f;
    color: #b7b7b7;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #333648;
    color: #ffffff;
}

QTabBar::tab:hover {
    background-color: #2c2f3d;
}

/* --------------------------- مجموعات ومقسمات --------------------------- */
QGroupBox {
    color: #e6e6e6;
    border: 1px solid #2e303c;
    border-radius: 8px;
    margin-top: 12px;
    padding: 12px 10px 10px 10px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #9a9dab;
}

QSplitter::handle {
    background-color: #2e303c;
}

QProgressBar {
    background-color: #24262f;
    border: 1px solid #2e303c;
    border-radius: 6px;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background-color: #27ae60;
    border-radius: 5px;
}

/* --------------------------- شريط الحالة والقوائم --------------------------- */
QStatusBar {
    background-color: #1e1f26;
    color: #9a9dab;
    border-top: 1px solid #2e303c;
}

QMenu {
    background-color: #24262f;
    color: #e6e6e6;
    border: 1px solid #3a3d4d;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 18px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #4a90e2;
    color: #ffffff;
}

QScrollBar:vertical {
    background: #1a1b22;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #3a3d4d;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #4a4d5e;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QToolTip {
    background-color: #24262f;
    color: #e6e6e6;
    border: 1px solid #3a3d4d;
    padding: 6px;
    border-radius: 4px;
}
